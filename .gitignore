# Never commit state files or provider binaries
*.tfstate
*.tfstate.*
*.tfstate.backup
.terraform/
.terraform.lock.hcl

# Never commit private keys
*.p8
*.pem
*.key

# Python virtual environments
.venv/
venv/

# Local override files
terraform.tfvars
*.auto.tfvars
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Client workshop decks / architecture reference docs — kept locally for reference, not
# part of the actual platform codebase, not meant to be tracked or shown in the repo.
*.pptx
MDP_Platform_Engineering_CICD_IaC_Repo_Architecture_v0.1.md
MDP_Platform_Solution_Architecture_v0.3.md

# DCM per-domain `sources/` is synthesized at build time from dcm/_template/ + dcm/account/
# (see dcm/sync-domain.sh) — never committed, always regenerated fresh before every
# `snow dcm plan/deploy`. This is the mechanism that keeps domain onboarding at zero
# duplicated SQL: editing the one shared template updates every domain's next deploy.
dcm/domains/*/sources/
